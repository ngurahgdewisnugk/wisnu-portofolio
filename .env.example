# Copy to .env for local runs:  cp .env.example .env
# Never commit .env. In production these values come from GitHub Secrets.

# GitHub account whose repos feed the Projects page.
# Optional: defaults to profile.githubUsername in src/data/profile.ts.
GITHUB_USERNAME=

# Fine-grained personal access token, read-only, public repositories only.
# Optional for the Projects page (raises the rate limit from 60 to 5000 req/h),
# required for the contributions calendar (GitHub GraphQL needs a token).
# Stored in GitHub Secrets as GH_API_TOKEN (secret names cannot start with GITHUB_).
GITHUB_TOKEN=
